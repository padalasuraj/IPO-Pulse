# ---------------------------------------------------------------------------
# IPO Pulse environment
#
# NOTHING here is required to run the app locally. With no env vars set, the
# app serves realistic seed data (great for a first `npm run dev` and for
# screenshots). Each block below unlocks one more layer of the stack.
# ---------------------------------------------------------------------------

# Which data source the app reads from.
#   live    -> live open IPOs from LIVE_IPO_API_URL (default)
#   seed    -> bundled sample dataset
#   scraper -> Playwright scraper (only works on the worker host, not on Vercel)
DATA_PROVIDER=live
LIVE_IPO_API_URL="https://ipo-tracker-api-lxje.onrender.com"

# ---- Postgres (optional) --------------------------------------------------
# Neon / Supabase / Vercel Postgres connection string. When set, the app reads
# and persists IPOs in the DB. When unset, it falls back to seed data.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ---- Upstash Redis (optional, Vercel-friendly cache) ----------------------
# HTTP-based Redis. Used to cache the IPO list for a short TTL.
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxx"

# ---- BullMQ worker (optional, runs OFF Vercel) ----------------------------
# Standard TCP Redis URL used by the BullMQ queue + worker. This is a
# long-running process, so host it on Railway / Render / Fly, not on Vercel.
# REDIS_URL="redis://default:password@host:6379"

# ---- Vercel Cron auth (optional) ------------------------------------------
# Protects /api/cron/refresh. Vercel Cron sends this automatically once set
# in the project settings. Locally you can call the endpoint with:
#   curl -H "Authorization: Bearer dev-secret" localhost:3000/api/cron/refresh
CRON_SECRET="dev-secret"

# ---- Public ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="IPO Pulse"
